# ==============================================================================
# The New Breed Church — environment variable template.
# Real values live in .env (repo root, gitignored) and apps/web/.env.local
# (Next.js only reads env files from its own app directory, not the monorepo
# root, so both need the same values — see README for the local setup flow).
# Docker Compose reads the root .env directly (docker-compose.yml env_file) —
# there is no separate .env.docker.
# ==============================================================================

# --- Database (Postgres) ------------------------------------------------------
# Local Docker (matches docker-compose.yml):
DATABASE_URL=postgresql://nbchurch:nbchurch@localhost:5432/nbchurch?schema=public
DIRECT_URL=postgresql://nbchurch:nbchurch@localhost:5432/nbchurch?schema=public
# Production (Neon) — replace with the pooled connection string from your Neon project:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
# DIRECT_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# --- Redis (cache + rate limiting) --------------------------------------------
# Local Docker:
REDIS_URL=redis://localhost:6379
# Production (Upstash) — use the REST credentials from your Upstash console:
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

# --- Auth (NextAuth / Auth.js — password login, see apps/web/lib/auth.ts) -----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with: openssl rand -hex 32
# Comma-separated list of emails allowed to hold an admin account:
ADMIN_ALLOWLIST_EMAILS=churchnewbreed@gmail.com
# Secret used to sign email-verification / password-reset tokens (separate from
# NEXTAUTH_SECRET so rotating one doesn't invalidate active sessions):
ADMIN_TOKEN_SECRET=generate-with: openssl rand -hex 32
# Idle time (minutes) before an admin session is force-expired client-side:
ADMIN_SESSION_IDLE_MINUTES=15

# --- Email (Resend) -------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=The New Breed Church <no-reply@thenewbreedchurch.org>
CONTACT_NOTIFICATION_EMAIL=churchnewbreed@gmail.com

# --- App -------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated list of origins allowed to call any explicitly cross-origin
# route (there should be very few — same-origin Server Actions need nothing here):
ALLOWED_ORIGINS=https://www.thenewbreedchurch.org

# --- pgAdmin (local Docker only, not used by the app itself) --------------------
PGADMIN_DEFAULT_EMAIL=admin@thenewbreedchurch.org
PGADMIN_DEFAULT_PASSWORD=change-me-locally

# --- Legacy migration (one-time use by scripts/migrate-legacy-data.mjs) ---------
# Only needed while running the legacy Firestore export once; delete afterward
# and rotate the underlying Firebase key (see HANDOFF.md action items).
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
