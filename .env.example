# ==============================================================================
# The New Breed Church — environment variable template.
# Real values live in .env (repo root, gitignored) and apps/web/.env.local
# (Next.js only reads env files from its own app directory, not the monorepo
# root, so both need the same values — see README for the local setup flow).
# Docker Compose reads the root .env directly (docker-compose.yml env_file) —
# there is no separate .env.docker.
# ==============================================================================

# --- Database (Postgres) ------------------------------------------------------
# Local Docker (matches docker-compose.yml):
DATABASE_URL=postgresql://nbchurch:nbchurch@localhost:5432/nbchurch?schema=public
DIRECT_URL=postgresql://nbchurch:nbchurch@localhost:5432/nbchurch?schema=public
# Production (Neon) — replace with the pooled connection string from your Neon project:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
# DIRECT_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# --- Redis (cache + rate limiting) --------------------------------------------
# Local Docker:
REDIS_URL=redis://localhost:6379
# Production (Upstash) — use the REST credentials from your Upstash console:
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

# --- Auth (hand-rolled cookie-session admin auth, see apps/web/lib/session.ts) --
# Comma-separated list of emails allowed to hold an admin account:
ADMIN_ALLOWLIST_EMAILS=churchnewbreed@gmail.com
# Optional: if set, every ADMIN_ALLOWLIST_EMAILS account is kept in sync with
# this password on every `pnpm seed` run instead of getting a random one-time
# password. Leave unset for the default random-password-per-account flow.
# ADMIN_FIXED_PASSWORD=choose-a-strong-password
# Idle time (minutes) before an admin session is force-expired client-side:
ADMIN_SESSION_IDLE_MINUTES=15

# --- Email (Resend) -------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The FROM address's domain must match whatever domain is actually verified in
# the Resend dashboard -- this church verified a subdomain (followup.<root>),
# not the root domain itself, so the address has to live on that subdomain:
EMAIL_FROM=The New Breed Church <hello@followup.thenewbreedchurch.org>
# General contact-form notifications always go here, plus (in addition) one of
# the three category-specific addresses below depending on what the visitor
# selected as their reason for contacting:
CONTACT_NOTIFICATION_EMAIL=admin@thenewbreedchurch.org
PRAYER_NOTIFICATION_EMAIL=prayer@thenewbreedchurch.org
MEMBERSHIP_NOTIFICATION_EMAIL=followup@thenewbreedchurch.org
WELFARE_NOTIFICATION_EMAIL=welfare@thenewbreedchurch.org

# --- Image uploads (Cloudflare R2, see apps/web/lib/r2.ts, apps/web/actions/admin/upload.ts) ---
# Optional: without these, every admin image field still works via its
# manual path/URL text input — only the "Upload image" button is disabled
# (returns a clear error instead of crashing). See dash.cloudflare.com → R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=nb-church-media
# Public bucket URL — the R2.dev subdomain shown after enabling Public
# Access on the bucket (or a custom domain configured later, same env var):
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# --- App -------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- pgAdmin (local Docker only, not used by the app itself) --------------------
PGADMIN_DEFAULT_EMAIL=admin@thenewbreedchurch.org
PGADMIN_DEFAULT_PASSWORD=change-me-locally

# --- Legacy migration (one-time use by scripts/migrate-legacy-data.mjs) ---------
# Only needed while running the legacy Firestore export once; delete afterward
# and rotate the underlying Firebase key (see HANDOFF.md action items).
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
