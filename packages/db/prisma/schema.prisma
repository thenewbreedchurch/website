generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Singleton site-wide content: contact info, socials, livestream/meeting links.
// Read on nearly every page render (header/footer) — always accessed through
// the Redis-cached getChurchSettings() helper in apps/web/lib/settings.ts,
// never queried ad-hoc, so cache invalidation stays centralized.
// ---------------------------------------------------------------------------
model ChurchSettings {
  id                    String   @id @default("singleton")
  orgName               String   @default("The New Breed Church")
  tagline               String   @default("A place to grow in faith, hope, and love")
  missionStatement      String   @default("")
  visionStatement       String   @default("")
  streetAddress         String   @default("8th Floor Trinity Towers, Chief Yesufu Abiodun Way")
  addressLocality       String   @default("Victoria Island")
  addressRegion         String   @default("Lagos")
  addressCountry        String   @default("Nigeria")
  phone                 String   @default("+234 916 150 9000")
  email                 String   @default("admin@thenewbreedchurch.org")
  mapEmbedUrl           String?
  facebookUrl           String?
  instagramUrl          String?  @default("https://www.instagram.com/the_newbreedchurch")
  youtubeUrl            String?  @default("https://www.youtube.com/@the_newbreedchurch")
  tiktokUrl             String?
  livestreamUrl         String?  @default("https://www.youtube.com/@the_newbreedchurch/live")
  memberRegistrationUrl String?  @default("https://apps.thenewbreedchurch.org/membership-form")
  onlineMeetingUrl      String?  @default("https://meet.google.com/zkb-qrmi-ooy")
  updatedAt             DateTime @updatedAt
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// Fixed weekly rhythm (Sunday School, Bible Study, daily prayers). Distinct
// from Announcement, which is for one-off / occasional items.
model ServiceTime {
  id        String    @id @default(cuid())
  dayOfWeek DayOfWeek
  label     String
  startTime String
  endTime   String?
  isOnline  Boolean   @default(false)
  onlineUrl String?
  location  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, dayOfWeek, sortOrder])
}

enum AnnouncementCategory {
  SERVICE
  OUTREACH
  YOUTH
  SPECIAL
  FUNDRAISER
  OTHER
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// Replaces the hardcoded event cards in the legacy events.html. Supports an
// RRULE for genuinely recurring occasional items (e.g. "last Saturday of the
// month" evangelism) so the fragile Nth-Sunday JS in the old site goes away.
model Announcement {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  title                String
  description          String
  category             AnnouncementCategory @default(OTHER)
  startDateTime        DateTime
  endDateTime          DateTime?
  recurrenceRule       String?
  location             String?
  isOnline             Boolean              @default(false)
  onlineUrl            String?
  heroImageUrl         String?
  registrationRequired Boolean              @default(false)
  registrationDeadline DateTime?
  capacity             Int?
  status               AnnouncementStatus   @default(DRAFT)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  registrations        EventRegistration[]

  @@index([status, startDateTime])
  @@index([category, status])
}

model EventRegistration {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String?
  guestsCount    Int          @default(1)
  notes          String?
  createdAt      DateTime     @default(now())

  @@unique([announcementId, email])
  @@index([announcementId, createdAt])
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

// Consolidates the legacy flat-file (data/subscribers.json) + Firestore split
// into a single store. See scripts/migrate-legacy-data.mjs for the one-time
// migration of existing subscribers.
model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  status           SubscriberStatus @default(ACTIVE)
  source           String?
  unsubscribeToken String           @unique @default(cuid())
  subscribedAt     DateTime         @default(now())
  unsubscribedAt   DateTime?

  @@index([status, subscribedAt])
}

enum ContactStatus {
  NEW
  READ
  RESPONDED
}

// Drives notification routing in lib/email.ts: GENERAL and TESTIMONY go to
// admin@ alone; PRAYER/MEMBERSHIP/WELFARE each add their own dedicated
// address (prayer@/followup@/welfare@) in addition to admin@, which is
// always included regardless of category.
enum ContactCategory {
  GENERAL
  PRAYER
  MEMBERSHIP
  WELFARE
  TESTIMONY
}

model ContactMessage {
  id        String          @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  category  ContactCategory @default(GENERAL)
  status    ContactStatus   @default(NEW)
  createdAt DateTime        @default(now())

  @@index([status, createdAt])
  @@index([category, createdAt])
}

enum NewConvertInterest {
  BAPTISM
  BIBLE_STUDY
  MEET_LEADER
  SERVING
  OTHER
}

// New Converts page intake form — always routed to followup@ (see
// lib/email.ts), not category-routed like ContactMessage since it's
// inherently a follow-up-team submission regardless of what's checked.
model NewConvertInquiry {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  interests NewConvertInterest[]
  message   String?
  status    ContactStatus        @default(NEW)
  createdAt DateTime             @default(now())

  @@index([status, createdAt])
}

model Sermon {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  speaker      String
  series       String?
  scripture    String?
  description  String?
  videoUrl     String
  thumbnailUrl String?
  publishedAt  DateTime
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt])
}

model Testimony {
  id             String    @id @default(cuid())
  authorName     String
  authorPhotoUrl String?
  body           String
  isFeatured     Boolean   @default(false)
  isApproved     Boolean   @default(false)
  submittedAt    DateTime  @default(now())
  publishedAt    DateTime?

  @@index([isApproved, isFeatured, publishedAt])
}

// Powers the public /leadership directory as well as the About page's
// existing leadership section. `role` is the person's title (e.g. "Senior
// Pastor"); `department` is the ministry/area they oversee (e.g. "Baptism &
// Discipleship") -- a distinct concept, not always set for every leader.
model StaffMember {
  id         String  @id @default(cuid())
  name       String
  role       String
  department String?
  email      String?
  phone      String?
  photoUrl   String?
  bio        String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  @@index([isActive, sortOrder])
}

model GivingAccount {
  id            String  @id @default(cuid())
  fundName      String
  currency      String
  bankName      String
  accountNumber String
  accountName   String
  swiftCode     String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  @@index([isActive, sortOrder])
}

enum NextStepPage {
  FIRST_TIMER
  NEW_CONVERT
}

model NextStep {
  id        String       @id @default(cuid())
  page      NextStepPage
  title     String
  body      String
  imageUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)

  @@index([page, isActive, sortOrder])
}

// Password-based admin login (NextAuth Credentials provider, see
// apps/web/lib/auth.ts). Membership is still gated by ADMIN_ALLOWLIST_EMAILS
// at signup time, but credentials/session state live here, not in env.
model AdminUser {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  name                String?
  passwordHash        String
  mustChangePassword  Boolean                   @default(false)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int                       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  lastLoginAt         DateTime?
  verificationTokens  AdminVerificationToken[]
  passwordResetTokens AdminPasswordResetToken[]
  sessions            AdminSession[]

  @@index([email, lockedUntil])
}

// Session records backing NextAuth's database session strategy. Storing
// sessions server-side (rather than a pure stateless JWT) is what makes
// "log out everywhere" / force-expiring a session on inactivity actually
// possible — the session row is deleted, not just a client cookie cleared.
model AdminSession {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

// One-time email-verification token issued at admin account creation.
// Tokens are stored hashed (never plaintext) so a DB read alone can't be
// used to verify/reset an account.
model AdminVerificationToken {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, expiresAt])
}

// One-time forgot-password token, same hashed-at-rest treatment as above.
model AdminPasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, expiresAt])
}

// Anonymous first-party pageview counter for the admin dashboard's "visits
// over time" / "most viewed" insight cards — deliberately just a path +
// timestamp, no IP, no user-agent, no visitor/session id, matching the
// site's existing no-tracking-cookies stance (see the cookie consent
// banner). Written by app/api/track/route.ts, fired from
// components/analytics/page-view-tracker.tsx on every public-page view.
model PageView {
  id        String   @id @default(cuid())
  path      String
  // Only ever set when the visitor has actively accepted non-essential
  // cookies via the site's cookie-consent banner (see
  // components/consent/cookie-consent-banner.tsx and
  // components/analytics/page-view-tracker.tsx) — a random, anonymous,
  // first-party id used solely to de-duplicate views into a "unique
  // visitors" count. Never cross-site, never third-party.
  visitorId String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
  @@index([visitorId, createdAt])
}

enum WelfareGender {
  MALE
  FEMALE
}

enum WelfareMembershipStatus {
  REGISTERED
  UNREGISTERED
}

enum WelfareMembershipDuration {
  LT_1_MONTH
  LT_1_YEAR
  LT_3_YEARS
  THREE_YEARS
  GT_3_YEARS
}

enum WelfareSupportType {
  EMPLOYMENT
  SCHOOL_FEES
  FOOD
  FINANCIAL
  MEDICAL
  RENT
  OTHER
}

enum WelfareStatus {
  NEW
  IN_REVIEW
  ASSISTED
  CLOSED
}

// Submissions from the Welfare form on the Contact page (shown when the
// visitor picks the "Welfare / Member Care" category). Mirrors the welfare
// team's own intake form. Highly sensitive (finances, dependents, home
// address): only ever read through the admin panel, and the notification
// email goes to the welfare inbox only. No file attachments — see HANDOFF.md.
model WelfareRequest {
  id                    String                    @id @default(cuid())
  email                 String
  fullName              String
  occupation            String
  gender                WelfareGender
  age                   Int
  phone                 String
  address               String
  membershipStatus      WelfareMembershipStatus
  membershipDuration    WelfareMembershipDuration
  fellowshipGroup       String
  isWorker              Boolean
  department            String?
  supportType           WelfareSupportType
  supportOther          String?
  description           String
  specificRequest       String
  firstTimeSupport      Boolean
  lastAssistanceDate    DateTime?
  lastAssistanceType    WelfareSupportType?
  lastAssistanceOther   String?
  triedElsewhere        String
  hasDependents         Boolean
  dependentsCount       Int?
  dependentsAges        String?
  homeVisitOk           Boolean
  status                WelfareStatus             @default(NEW)
  adminNotes            String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  attachments           WelfareAttachment[]

  @@index([status, createdAt])
}

// Supporting documents uploaded with a welfare request. Stored in Postgres
// (not the public R2 bucket, which serves every object to anyone with the URL)
// so they are only ever reachable through the authenticated admin download
// route or as an attachment on the email to the welfare inbox. Deleted with
// their request (cascade). Never select `data` in list queries.
model WelfareAttachment {
  id        String         @id @default(cuid())
  requestId String
  request   WelfareRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime       @default(now())

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Vendor directory (/directory). Accounts here are SEPARATE from AdminUser —
// they belong to vendors and to community members who review them. Auth
// tables deliberately mirror the admin ones (hashed tokens at rest, server
// stored sessions, lockout) so the admin login stays untouched.
// ---------------------------------------------------------------------------

model DirectoryUser {
  id                  String                        @id @default(cuid())
  email               String                        @unique
  name                String
  passwordHash        String
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int                           @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  sessions            DirectorySession[]
  verificationTokens  DirectoryVerificationToken[]
  passwordResetTokens DirectoryPasswordResetToken[]
  vendors             Vendor[]
  reviews             VendorReview[]
}

model DirectorySession {
  id           String        @id @default(cuid())
  sessionToken String        @unique
  userId       String
  user         DirectoryUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  lastActiveAt DateTime      @default(now())
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model DirectoryVerificationToken {
  id        String        @id @default(cuid())
  userId    String
  user      DirectoryUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, expiresAt])
}

model DirectoryPasswordResetToken {
  id        String        @id @default(cuid())
  userId    String
  user      DirectoryUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, expiresAt])
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model VendorCategory {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  sortOrder     Int      @default(0)
  subcategories String[]
  vendors       Vendor[]
}

model Vendor {
  id                 String          @id @default(cuid())
  slug               String          @unique
  ownerId            String?
  owner              DirectoryUser?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  businessName       String
  status             VendorStatus    @default(PENDING)
  isVerified         Boolean         @default(false)
  isFeatured         Boolean         @default(false)
  categoryId         String
  category           VendorCategory  @relation(fields: [categoryId], references: [id])
  subcategory        String?
  description        String
  services           String[]
  location           String
  serviceAreas       String?
  yearStarted        Int?
  isRegistered       Boolean         @default(false)
  registrationNumber String?
  phone              String?
  whatsapp           String?
  email              String?
  website            String?
  instagram          String?
  facebook           String?
  linkedin           String?
  tiktok             String?
  businessHours      String?
  priceRange         String?
  logoUrl            String?
  coverUrl           String?
  // Shown to the owner (e.g. why a listing was rejected); not public.
  adminNotes         String?
  ratingAvg          Float           @default(0)
  ratingCount        Int             @default(0)
  viewsCount         Int             @default(0)
  contactClicksCount Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  images             VendorImage[]
  reviews            VendorReview[]
  reports            VendorReport[]
  stats              VendorStatDaily[]

  @@index([status, isFeatured])
  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([location])
  @@index([ownerId])
  @@index([email])
}

model VendorImage {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([vendorId, sortOrder])
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model VendorReview {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String
  user      DirectoryUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String
  status    ReviewStatus  @default(PUBLISHED)
  createdAt DateTime      @default(now())

  @@unique([vendorId, userId])
  @@index([vendorId, status, createdAt])
  @@index([status, createdAt])
}

enum ReportReason {
  SCAM
  INAPPROPRIATE
  WRONG_INFO
  CLOSED
  OTHER
}

enum ReportStatus {
  NEW
  REVIEWED
  ACTIONED
}

model VendorReport {
  id            String       @id @default(cuid())
  vendorId      String
  vendor        Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reason        ReportReason
  details       String?
  reporterEmail String?
  status        ReportStatus @default(NEW)
  createdAt     DateTime     @default(now())

  @@index([status, createdAt])
  @@index([vendorId])
}

enum VendorStatType {
  VIEW
  CALL
  WHATSAPP
  EMAIL
  WEBSITE
  SOCIAL
}

// Daily rolled-up counters (upsert-increment) instead of one row per click,
// so analytics storage stays bounded no matter how popular a listing gets.
// No IP, user-agent or visitor id is stored.
model VendorStatDaily {
  vendorId String
  vendor   Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  date     DateTime       @db.Date
  type     VendorStatType
  count    Int            @default(0)

  @@id([vendorId, date, type])
  @@index([date])
}
